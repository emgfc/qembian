+// Copyright (c) 2026 qembian contributors. Licensed under the Eclipse Public License v1.0.
+//
+// Fast-exec shims for the Symbian 9.2 personality (see ../sexecpers.cpp).
+// Fast execs run in SVC mode with interrupts disabled, so these read-modify-writes are atomic
+// on a uniprocessor. User memory is accessed with LDRT/STRT, as in cexec.cia.
+
+#include <e32cia.h>
+#include <arm.h>
+#include "nk_priv.h"
+
+// TInt User::SafeInc(TInt& a): if (a>0) ++a; return original a
+__NAKED__ TInt Exec92Shim_SafeInc32(TInt* /*a*/)
+	{
+	USER_MEMORY_GUARD_OFF(,r12,r12);
+	asm("ldrt r1, [r0] ");
+	asm("cmp r1, #0 ");
+	asm("addgt r2, r1, #1 ");
+	asm("strgtt r2, [r0] ");
+	asm("mov r0, r1 ");
+	USER_MEMORY_GUARD_ON(,r12,r12);
+	__JUMP(,lr);
+	}
+
+// TInt User::SafeDec(TInt& a): if (a>0) --a; return original a
+__NAKED__ TInt Exec92Shim_SafeDec32(TInt* /*a*/)
+	{
+	USER_MEMORY_GUARD_OFF(,r12,r12);
+	asm("ldrt r1, [r0] ");
+	asm("cmp r1, #0 ");
+	asm("subgt r2, r1, #1 ");
+	asm("strgtt r2, [r0] ");
+	asm("mov r0, r1 ");
+	USER_MEMORY_GUARD_ON(,r12,r12);
+	__JUMP(,lr);
+	}
