@@ -0,0 +1,181 @@
+// Copyright (c) 2026 qembian contributors. Licensed under the Eclipse Public License v1.0.
+//
+// Symbian OS 9.2 executive-call personality.
+//
+// User-side code built for Symbian 9.2 (e.g. Nokia N95 8GB EUSER) enters the kernel with the
+// 9.2 SWI numbering. When the ROM header's kernel config flags have
+// KKernelConfigExec92Personality set, every user thread gets these tables instead of the native
+// ones. They are built at boot by copying entries out of the native tables according to
+// execpers_map.h (generated from personalities/sym92/exec.map), plus a few shims for calls whose 9.2
+// semantics differ, and logging stubs for 9.2 calls that have no equivalent.
+
+#include <kernel/kern_priv.h>
+#include <kernel/execs.h>
+#include "execpers_map.h"
+
+const TUint32 KKernelConfigExec92Personality = 1u<<29;
+
+TBool Exec92Enabled = EFalse;
+TUint32 EpocFastExecTable92[EXEC92_FAST_COUNT];
+TUint32 EpocSlowExecTable92[3 + 2*EXEC92_SLOW_COUNT];
+volatile TUint32 Exec92LastBadFast = 0;		// fast execs run with interrupts off: record, don't print
+
+// Size difference of loader structures for the current thread: 9.2 TProcessCreateInfo lacks
+// iDebugAttributes, iDestructStat and iFlags (12 bytes) at the end.
+TInt Exec92ProcessCreateInfoShrink()
+	{
+	if (!Exec92Enabled)
+		return 0;
+	const SSlowExecEntry* t = TheCurrentThread->iNThread.iSlowExecTable;
+	return t == ((const SSlowExecTable*)EpocSlowExecTable92)->iEntries ? 12 : 0;
+	}
+
+// --- shims ------------------------------------------------------------------------------------
+
+extern TInt Exec92Shim_SafeInc32(TInt*);	// cexecpers.cia
+extern TInt Exec92Shim_SafeDec32(TInt*);	// cexecpers.cia
+
+// 9.2 RMutex::Wait() passes no timeout; r1 is whatever the caller left there.
+TInt Exec92Shim_MutexWait92(DMutex* aMutex)
+	{
+	return ExecHandler::MutexWait(aMutex, 0);
+	}
+
+// 9.2 RHandleBase::Duplicate(): Exec::HandleDuplicate(aThreadHandle, aType, aHandle) with the
+// source handle passed by value; returns the new handle (>=0) or an error. Ours takes TInt& in/out.
+// Same logic as ExecHandler::HandleDuplicate (sexec.cpp) without the user-memory round trip.
+TInt Exec92Shim_HandleDuplicate92(TInt aThreadHandle, TOwnerType aType, TInt aHandle)
+	{
+	TInt h = aHandle;
+	DThread* pC=TheCurrentThread;
+	NKern::LockSystem();
+	DThread* pT=(DThread*)K::ThreadEnterCS(aThreadHandle,EThread);
+	TInt r=KErrBadHandle;
+	NKern::LockSystem();
+	DObject* pO=pT->ObjectFromHandle(h);
+	h = 0;
+	if (pO)
+		r=pO->Open();
+	NKern::UnlockSystem();
+	if (r==KErrNone)
+		{
+		if (pO->Protection()!=DObject::EGlobal
+			&& pT->iOwningProcess->iSecurityZone!=pC->iOwningProcess->iSecurityZone)
+			r = PlatSec::ProcessIsolationFail(__PLATSEC_DIAGNOSTIC_STRING("Checked by RHandleBase::Duplicate (9.2)"));
+		if (r==KErrNone)
+			r = pC->MakeHandle(aType, pO, h);
+		if (r<KErrNone)
+			pO->Close(NULL);
+		}
+	pT->Close(NULL);
+	NKern::ThreadLeaveCS();
+	if (r == KErrBadHandle)
+		K::PanicKernExec(EBadHandle);
+	return r==KErrNone ? h : r;
+	}
+
+// flags for slow shims: same handle preprocessing / system lock usage as the native call
+static TUint32 SlowFlagsOf(TInt aOurSlowNumber)
+	{
+	return EpocSlowExecTable[3 + 2*aOurSlowNumber];
+	}
+
+// --- logging stubs for 9.2 calls with no mapping ----------------------------------------------
+
+#define BAD_SLOW(n) \
+	static TInt Exec92BadSlow_##n(TInt a0, TInt a1, TInt a2, TInt a3) \
+		{ \
+		Kern::Printf("EXEC92: unmapped 9.2 slow exec 0x%02x args %08x %08x %08x %08x", n, a0, a1, a2, a3); \
+		return KErrNotSupported; \
+		}
+#define BAD_FAST(n) \
+	static TInt Exec92BadFast_##n(TInt) { Exec92LastBadFast = 0x800000|n; return 0; }
+EXEC92_BAD_SLOW(BAD_SLOW)
+EXEC92_BAD_FAST(BAD_FAST)
+
+static TLinAddr BadSlowFunc(TInt n)
+	{
+#define CASE(x) case x: return (TLinAddr)&Exec92BadSlow_##x;
+	switch (n) { EXEC92_BAD_SLOW(CASE) }
+#undef CASE
+	return 0;
+	}
+
+static TLinAddr BadFastFunc(TInt n)
+	{
+#define CASE(x) case x: return (TLinAddr)&Exec92BadFast_##x;
+	switch (n) { EXEC92_BAD_FAST(CASE) }
+#undef CASE
+	return 0;
+	}
+
+#define SHIM_FUNC(k, name, kind, base) case k: return (TLinAddr)&Exec92Shim_##name;
+static TLinAddr ShimFunc(TInt k)
+	{
+	switch (k) { EXEC92_SHIMS(SHIM_FUNC) }
+	return 0;
+	}
+#undef SHIM_FUNC
+
+#define EExecNone (-1)
+#define SHIM_FLAGS(k, name, kind, base) case k: return EExec##base<0 ? 0 : SlowFlagsOf(EExec##base);
+static TUint32 ShimFlags(TInt k)
+	{
+	switch (k) { EXEC92_SHIMS(SHIM_FLAGS) }
+	return 0;
+	}
+#undef SHIM_FLAGS
+
+// --- table construction -----------------------------------------------------------------------
+
+void Exec92Init()
+	{
+	if (!(TheSuperPage().KernelConfigFlags() & KKernelConfigExec92Personality))
+		return;
+	TheSuperPage().SetKernelConfigFlags(TheSuperPage().KernelConfigFlags() & ~KKernelConfigExec92Personality);
+
+	EpocFastExecTable92[0] = EXEC92_FAST_COUNT;
+	for (TInt n=1; n<EXEC92_FAST_COUNT; ++n)
+		{
+		TInt m = KExec92Fast[n];
+		TLinAddr f;
+		if (m >= 0)
+			f = EpocFastExecTable[m];
+		else if (m == EXEC92_INVALID)
+			f = BadFastFunc(n);
+		else
+			f = ShimFunc(-2-m);
+		__ASSERT_ALWAYS(f, K::Fault(K::EInit3Failed));
+		EpocFastExecTable92[n] = f;
+		}
+
+	EpocSlowExecTable92[0] = EXEC92_SLOW_COUNT;
+	EpocSlowExecTable92[1] = EpocSlowExecTable[1];	// invalid handler (out of range numbers)
+	EpocSlowExecTable92[2] = EpocSlowExecTable[2];	// preprocess (handle lookup) handler
+	for (TInt n=0; n<EXEC92_SLOW_COUNT; ++n)
+		{
+		TInt m = KExec92Slow[n];
+		TUint32 flags;
+		TLinAddr f;
+		if (m >= 0)
+			{
+			flags = EpocSlowExecTable[3 + 2*m];
+			f = EpocSlowExecTable[4 + 2*m];
+			}
+		else if (m == EXEC92_INVALID)
+			{
+			flags = 0;
+			f = BadSlowFunc(n);
+			}
+		else
+			{
+			flags = ShimFlags(-2-m);
+			f = ShimFunc(-2-m);
+			}
+		__ASSERT_ALWAYS(f, K::Fault(K::EInit3Failed));
+		EpocSlowExecTable92[3 + 2*n] = flags;
+		EpocSlowExecTable92[4 + 2*n] = f;
+		}
+	Exec92Enabled = ETrue;
+	Kern::Printf("EXEC92: Symbian 9.2 exec personality enabled (%d fast, %d slow)", EXEC92_FAST_COUNT, EXEC92_SLOW_COUNT);
+	}
