 TInt ExecLoaderCodeSegSize = sizeof(TCodeSegCreateInfo);
 TInt ExecLoaderProcessTail = sizeof(TProcessCreateInfo) - sizeof(TCodeSegCreateInfo);
+// Belle FP2 (sym102): TCodeSegCreateInfo has 4 more bytes (476; sizeof 480 with 8-byte alignment: CodeSegCreate
+// copies 0x1e0, Belle 0x1d8; the same offsets up to 0x178 in both phones' ekern) and TProcessCreateInfo's own
+// fields start at 476, in the base's tail padding (ProcessCreate copies 0x210 = 476 + 48 rounded) [V: KDLL trace,
+// the priority 350 read one word late at 480]. Ours is read from the start; the FP2 extra word is skipped.
+// ExecLoaderCodeSegUserSize = where TProcessCreateInfo's own fields start in the loader's structure: 476 on
+// FP2, ExecLoaderCodeSegSize (380) on 9.1, ours otherwise.
+TInt ExecLoaderCodeSegUserSize = sizeof(TCodeSegCreateInfo);
+// FP2's loader passes iUseCodePaging 2 for code it does not page: read as "not paged", given back as 2.
+TBool ExecLoaderPagingMode2 = EFalse;
 
