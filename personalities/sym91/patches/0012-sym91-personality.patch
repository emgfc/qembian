+// TInt User::LockedInc(TInt& a): ++a; return original a
+__NAKED__ TInt Exec92Shim_LockedInc91(TInt* /*a*/)
+	{
+	USER_MEMORY_GUARD_OFF(,r12,r12);
+	asm("ldrt r1, [r0] ");
+	asm("add r2, r1, #1 ");
+	asm("strt r2, [r0] ");
+	asm("mov r0, r1 ");
+	USER_MEMORY_GUARD_ON(,r12,r12);
+	__JUMP(,lr);
+	}
+
