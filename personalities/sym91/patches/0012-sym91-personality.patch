+	FindHandleFrom91(h, v, (TUint64)KMaxTInt64);	// 9.1 semantics: continue after that index
+	NKern::ThreadEnterCS();
+	TInt r = pC->FindByFullName(h, match, fn);
+	NKern::ThreadLeaveCS();
+	Kern::KUDesPut(aName, fn);
+	v = h.Handle();
+	kumemput32(&aFindHandle, &v, sizeof(v));
+	return r;
+	}
