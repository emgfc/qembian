// sybeth.pdd: the Ethernet PDD for QEMU's syborg-net mailbox NIC (see sybeth.cpp); PDD name "Ethernet.Syborg"
#include "../../variant.mmh"
#include <kernel/kern_ext.mmh>
target			VariantTarget(sybeth,pdd)
linkas			sybeth.pdd
targettype		pdd
OS_LAYER_SYSTEMINCLUDE_SYMBIAN
userinclude		../../specific		// syborg.h: KHwSVPNetDevice, EIntNet0
sourcepath		.
source			sybeth.cpp
library			PlatformLib		// Interrupt::Bind etc.
noexportlibrary
vendorid		0x70000001
capability		all
