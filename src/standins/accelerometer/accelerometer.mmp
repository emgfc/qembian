// accelerometer.ldd stand-in: Nokia's accelerometer channel on the host's syborg-sensor (see accelerometer.cpp)
#include "../../variant.mmh"
#include <kernel/kern_ext.mmh>
target			VariantTarget(accelerometer,ldd)
