// N95 nokiaiscdriverextension.ldd stand-in (see nokiastub.h)
#include "../../variant.mmh"
#include <kernel/kern_ext.mmh>
target			VariantTarget(nokiaiscdriverextension,ldd)
linkas			nokiaiscdriverextension.ldd
targettype		ldd
sourcepath		.
source			nokiaiscdriverextension.cpp
noexportlibrary
library			PlatformLib	// Interrupt:: for the QEMU modem port (iscpeer.inl)
vendorid		0x70000001
capability		all
userinclude		../_shared	// src/standins/_shared: nokiastub.h, iscpeer.inl, stubcert.h
