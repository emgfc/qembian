// Syborg LCD (frame buffer HAL) built for the N95 hybrid: reports 32 bpp in HAL mode 1 of 2,
// matching the N95 screen driver's mode numbering (0 = EColor64K, 1 = EColor16MU).
// Same source as ../../fb/fb.mmp; replaces LCD.DLL in the hybrid's kernel ROM.
#include "../../variant.mmh"
#include "kernel/kern_ext.mmh"
TARGET			VariantTarget(lcd_n95,dll)
TARGETTYPE		kext
MACRO			__PORTRAIT_DISPLAY__
MACRO			SYBORG_FB_REPORTED_BPP=32
MACRO			SYBORG_FB_DISPLAY_MODE=1
MACRO			SYBORG_FB_NUM_MODES=2
MACRO			SYBORG_FB_N95
SYSTEMINCLUDE	AsspNKernIncludePath
SYSTEMINCLUDE	../../fb
SOURCEPATH		../../fb
SOURCE			syborg_fb.cpp
LIBRARY			PlatformLib
EPOCALLOWDLLDATA
UID				0x1000008d 0x100039e8
VENDORID		0x70000001
ROMTARGET		lcd.dll
CAPABILITY		all
