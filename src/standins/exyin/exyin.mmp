// EXYIN.DLL: touch-screen digitiser on the Syborg pointer device (see exyin.cpp)
#include "../../variant.mmh"
#include <kernel/kern_ext.mmh>
target			VariantTarget(exyin,dll)
targettype		kext
linkas			exyin.dll
OS_LAYER_SYSTEMINCLUDE_SYMBIAN
SYSTEMINCLUDE	AsspNKernIncludePath
userinclude		../../specific
userinclude		../_shared		// boardconfig.h
