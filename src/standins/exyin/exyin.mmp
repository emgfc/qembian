source			d_xyin.cpp		// the kernel's generic DDigitiser (EPL)
sourcepath		.
source			exyin.cpp
library			PlatformLib
noexportlibrary
uid				0x1000008d 0x100039ea
vendorid		0x70000001
capability		all
