// N95 ehwa.ldd stand-in (see nokiastub.h)
#include "../../variant.mmh"
#include <kernel/kern_ext.mmh>
target			VariantTarget(ehwa,ldd)
linkas			ehwa.ldd
targettype		ldd
sourcepath		.
source			ehwa.cpp
library			PlatformLib		// Interrupt::Bind (syborg-snd IRQ)
noexportlibrary
vendorid		0x70000001
capability		all
epocallowdlldata
userinclude		../../specific
userinclude		../_shared	// src/standins/_shared: nokiastub.h, iscpeer.inl, isireplies.h, stubcert.h
