# Hosted EKA2 guest kernel: arm64 defconfig plus these (docs/hosted-eka2/qemu-setup.md section 2).
# 32-bit EL0 processes (the phone's ROM code runs as AArch32 user code)
CONFIG_COMPAT=y
CONFIG_KUSER_HELPERS=y
CONFIG_ARMV8_DEPRECATED=y
CONFIG_SWP_EMULATION=y
CONFIG_CP15_BARRIER_EMULATION=y
CONFIG_SETEND_EMULATION=y
CONFIG_COMPAT_ALIGNMENT_FIXUPS=y
CONFIG_ARM64_4K_PAGES=y
CONFIG_ARM64_VA_BITS_48=y
# exec trapping, shared kernel data, cross-process copies
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_MEMFD_CREATE=y
CONFIG_CROSS_MEMORY_ATTACH=y
CONFIG_FUTEX=y
# initramfs boot, 9p share, serial console
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
# display, input, sound (P5)
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_INPUT_EVDEV=y
CONFIG_VIRTIO_INPUT=y
CONFIG_SND=y
CONFIG_SND_VIRTIO=y
# faster build: no modules
CONFIG_MODULES=n
