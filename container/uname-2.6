#!/bin/sh
# Report a 2.6.32 kernel release, like `setarch --uname-2.6` (not available in squeeze's
# util-linux). 2010-era configure scripts derive platform names from `uname -r`; on a modern
# host kernel (7.x) Raptor's bundled Python 2.7 ends up with sys.platform == "linux7", which
# Raptor rejects. Everything except the release string is passed through to the real uname.
case " $* " in
  *" -r "*|*" --kernel-release "*) [ $# -eq 1 ] && { echo 2.6.32; exit 0; } ;;
esac
/bin/uname "$@" | sed -E 's/ [0-9]+\.[0-9]+\.[0-9]+[^ ]* / 2.6.32 /'
