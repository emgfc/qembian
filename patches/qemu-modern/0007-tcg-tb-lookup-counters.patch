@@ -0,0 +1,20 @@
+/*
+ * qembian (patches/qemu-modern/0007): counters of the TB lookup path, printed every 2^25 lookups to stderr
+ * when SYBORG_TB_STATS=1 (docs/perf.md). One vCPU: plain increments.
+ */
+#ifndef SYB_STATS_H
+#define SYB_STATS_H
+enum {
+    SYB_LK_HELPER, SYB_LK_LOOP, SYB_LK_OTHER,               /* lookups by source */
+    SYB_JC_HIT, SYB_JC_EMPTY, SYB_JC_CONFLICT, SYB_JC_KEY,   /* jump cache: hit; miss on an empty slot, another
+                                                                pc in the slot, the same pc with another key */
+    SYB_HT_HIT, SYB_HT_MISS,                                 /* hash table after a jump-cache miss */
+    SYB_FL_RESET, SYB_FL_TBFLUSH, SYB_FL_PCREL, SYB_FL_TLB, SYB_FL_RANGE, SYB_FL_DOMAIN,   /* full flushes */
+    SYB_PG_CLEAR, SYB_PG_PARKED,                             /* page clears: current, parked contexts */
+    SYB_TB_GEN,                                              /* translations */
+    SYB_N
+};
+extern uint64_t syb_stat[SYB_N];
+#define SYB_STAT(k) (syb_stat[k]++)
+void syb_stat_print(void);
+#endif
