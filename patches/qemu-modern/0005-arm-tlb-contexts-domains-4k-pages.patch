+/*
+ * qembian: an ASID's TLB context key (tlb_asid_switch): ASID and security state
+ */
+static uint64_t arm_tlb_ctx_key(bool secure, uint32_t asid)
+{
+    return (uint64_t)secure << 8 | (asid & 0xff);
+}
+
+/* access level of a DACR domain field: 0 no access (incl. reserved), 1 client, 2 manager */
+static int dacr_level(uint32_t v)
+{
+    return v == 1 ? 1 : v == 3 ? 2 : 0;
+}
+
 static void dacr_write(CPUARMState *env, const ARMCPRegInfo *ri, uint64_t value)
 {
     ARMCPU *cpu = env_archcpu(env);
+    uint32_t old = raw_read(env, ri);
 
+    if (old == value) {
+        return;         /* qembian: unchanged domains change no translation */
+    }
     raw_write(env, ri, value);
+    static int track = -1;
+    if (track < 0) {
+        const char *e = getenv("SYBORG_DACR_TRACK");
+        track = !(e && !strcmp(e, "0"));
+    }
+    /*
+     * ARMv6 only: an ARMv5 guest (Symbian's moving memory model) changes the DACR on
+     * thread switches and flushes on process switches anyway, so it gains nothing here.
+     */
+    if (track && arm_feature(env, ARM_FEATURE_V6) &&
+        !arm_feature(env, ARM_FEATURE_PMSA) && !extended_addresses_enabled(env)) {
+        /*
+         * qembian: TLB entries carry their domain (ptw.c); only the domains
+         * whose access level drops can make a cached entry too permissive
+         * (more access: missing permissions are re-walked). Symbian's
+         * flexible memory model toggles its IPC alias domain around every
+         * cross-process copy: a flush each time cost most of QEMU's time.
+         */
+        uint32_t drop = 0;
+        for (int d = 0; d < 16; d++) {
+            if (dacr_level((value >> (2 * d)) & 3) < dacr_level((old >> (2 * d)) & 3)) {
+                drop |= 1u << d;
+            }
+        }
+        if (drop) {
+            tlb_flush_domains(CPU(cpu), drop);
+        }
+        return;
+    }
     tlb_flush(CPU(cpu)); /* Flush TLB as domain not tracked in TLB */
 }
 
