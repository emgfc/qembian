+/*
+ * qembian: ASID-tagged TLB contexts for ARMv6/v7 short-descriptor guests.
+ *
+ * Without them every change of the ASID (CONTEXTIDR) flushes the whole softmmu TLB and the jump
+ * cache: on Symbian, where every client/server IPC switches address space, QEMU then spent most
+ * of its time refilling the TLB and looking translation blocks up in the hash table. (DACR
+ * writes, the other frequent flush, drop only the entries of domains whose access level falls:
+ * tlb_flush_domains.) Instead the
+ * current TLB tables and jump cache are parked under the old ASID and the new ASID's are brought
+ * back (or fresh ones made), like a CPU with an ASID-tagged TLB.
+ * Correctness: guests must invalidate by MVA/ASID when they change a mapping (they must on real
+ * hardware too). Page invalidations are applied to every parked context; any by-mmuidx or range
+ * flush (TLBIALL, TLBIASID, DACR, SCTLR..., memory map changes) drops them all; code-page write
+ * protection (tlb_reset_dirty) is applied to them; a translation cache flush clears their jump
+ * caches. Single vCPU only (the syborg board); SYBORG_ASID_TLB=0 turns it off.
+ */
+#define ASID_CTX_MAX 16
+typedef struct AsidCtx {
+    bool valid;
+    uint64_t key;
+    uint64_t lru;
+    MMUIdxMap dirty;
+    uint32_t domains;                    /* short-descriptor domains its entries came from */
+    uint32_t code_domains;               /* ... of which ever executable (jump cache) */
+    CPUTLBDesc d[NB_MMU_MODES];
+    CPUTLBDescFast f[NB_MMU_MODES];
+    CPUJumpCache *jc;
+} AsidCtx;
+
+static AsidCtx asid_ctx[ASID_CTX_MAX];
+static CPUState *asid_cpu;
+static uint32_t asid_cur_domains;        /* the current context's (see AsidCtx.domains) */
+static uint32_t asid_cur_code_domains;   /* the current context's (see AsidCtx.code_domains) */
+static uint64_t asid_tick;
+static int asid_enabled = -1;
+static uint64_t asid_stat[6];            /* switches, hits, misses, drops, page flushes, evictions */
+
+static void asid_ctx_stats(void)
+{
+    static int64_t last;
+    int64_t now = get_clock_realtime();
+    if (getenv("SYBORG_ASID_TLB_STATS") && now - last > 5000000000LL) {
+        last = now;
+        fprintf(stderr, "asid-tlb: switches %" PRIu64 " hits %" PRIu64 " misses %" PRIu64
+                " drops %" PRIu64 " page flushes %" PRIu64 " evictions %" PRIu64 "\n",
+                asid_stat[0], asid_stat[1], asid_stat[2], asid_stat[3], asid_stat[4], asid_stat[5]);
+    }
+}
+
+static void asid_ctx_free_locked(AsidCtx *c)
+{
+    for (int i = 0; i < NB_MMU_MODES; i++) {
+        g_free(c->f[i].table);          /* whole arrays: index order does not matter here */
+        g_free(c->d[i].fulltlb);
+        c->f[i].table = NULL;
+        c->d[i].fulltlb = NULL;
+    }
+    if (c->jc) {
+        g_free_rcu(c->jc, rcu);
+        c->jc = NULL;
+    }
+    c->valid = false;
+}
+
+static void asid_ctx_drop_all_locked(CPUState *cpu)
+{
+    if (cpu != asid_cpu) {
+        return;
+    }
+    for (int k = 0; k < ASID_CTX_MAX; k++) {
+        if (asid_ctx[k].valid) {
+            asid_ctx_free_locked(&asid_ctx[k]);
+            asid_stat[3]++;
+        }
+    }
+}
+
+static void asid_ctx_flush_page_locked(CPUState *cpu, MMUIdxMap idxmap, vaddr page, vaddr mask)
+{
+    if (cpu != asid_cpu) {
+        return;
+    }
+    for (int k = 0; k < ASID_CTX_MAX; k++) {
+        AsidCtx *c = &asid_ctx[k];
+        if (!c->valid) {
+            continue;
+        }
+        asid_stat[4]++;
+        for (int midx = 0; midx < NB_MMU_MODES; midx++) {
+            if (!((idxmap & c->dirty) >> midx & 1)) {
+                continue;               /* nothing cached in that index */
+            }
+            CPUTLBDesc *d = &c->d[midx];
+            CPUTLBDescFast *f = &c->f[mmuidx_to_fast_index(midx)];   /* f[] is stored reversed */
+            if ((page & d->large_page_mask) == d->large_page_addr) {
+                tlb_mmu_flush_locked(d, f);
+                continue;
+            }
+            uintptr_t i = (page >> TARGET_PAGE_BITS) & (f->mask >> CPU_TLB_ENTRY_BITS);
+            if (tlb_flush_entry_mask_locked(&f->table[i], page, mask)) {
+                d->n_used_entries--;
+            }
+            for (int v = 0; v < CPU_VTLB_SIZE; v++) {
+                if (tlb_flush_entry_mask_locked(&d->vtable[v], page, mask)) {
+                    d->n_used_entries--;
+                }
+            }
+        }
+    }
+}
+
+static void asid_ctx_jmp_clear_page(CPUState *cpu, vaddr page_addr)
+{
+    if (cpu != asid_cpu) {
+        return;
+    }
+    int i0 = tb_jmp_cache_hash_page(page_addr);
+    for (int k = 0; k < ASID_CTX_MAX; k++) {
+        CPUJumpCache *jc = asid_ctx[k].valid ? asid_ctx[k].jc : NULL;
+        for (int i = 0; jc && i < TB_JMP_PAGE_SIZE; i++) {
+            qatomic_set(&jc->array[i0 + i].tb, NULL);
+        }
+    }
+}
+
+static void asid_ctx_reset_dirty_locked(CPUState *cpu, uintptr_t start, uintptr_t length)
+{
+    if (cpu != asid_cpu) {
+        return;
+    }
+    for (int k = 0; k < ASID_CTX_MAX; k++) {
+        AsidCtx *c = &asid_ctx[k];
+        if (!c->valid) {
+            continue;
+        }
+        for (int midx = 0; midx < NB_MMU_MODES; midx++) {
+            if (!(c->dirty >> midx & 1)) {
+                continue;
+            }
+            CPUTLBDesc *desc = &c->d[midx];
+            CPUTLBDescFast *fast = &c->f[mmuidx_to_fast_index(midx)];
+            unsigned int n = tlb_n_entries(fast);
+            for (unsigned int i = 0; i < n; i++) {
+                tlb_reset_dirty_range_locked(&desc->fulltlb[i], &fast->table[i], start, length);
+            }
+            for (unsigned int i = 0; i < CPU_VTLB_SIZE; i++) {
+                tlb_reset_dirty_range_locked(&desc->vfulltlb[i], &desc->vtable[i], start, length);
+            }
+        }
+    }
+}
+
+/* entries of the given domains out of one context's tables */
+static void tlb_drop_domains_locked(CPUTLBDesc *d, CPUTLBDescFast *f, uint32_t domains)
+{
+    size_t n = tlb_n_entries(f);
+    for (size_t i = 0; i < n; i++) {
+        uint8_t dp = d->fulltlb[i].extra.arm.domain_plus1;
+        if (dp && (domains >> (dp - 1) & 1) && !tlb_entry_is_empty(&f->table[i])) {
+            memset(&f->table[i], -1, sizeof(f->table[i]));
+            d->n_used_entries--;
+        }
+    }
+    for (int v = 0; v < CPU_VTLB_SIZE; v++) {
+        uint8_t dp = d->vfulltlb[v].extra.arm.domain_plus1;
+        if (dp && (domains >> (dp - 1) & 1) && !tlb_entry_is_empty(&d->vtable[v])) {
+            memset(&d->vtable[v], -1, sizeof(d->vtable[v]));
+            d->n_used_entries--;            /* as tlb_flush_vtlb_page_mask_locked */
+        }
+    }
+}
+
+/*
+ * qembian: the access to these short-descriptor domains fell (DACR): their entries go from every
+ * context (current and parked), entries of other domains stay. Contexts that never cached such
+ * a domain are skipped (Symbian: unlocking the IPC alias domain costs nothing, locking it drops
+ * the alias pages only).
+ */
+void tlb_flush_domains(CPUState *cpu, uint32_t domains)
+{
+    bool code;
+
+    assert_cpu_is_self(cpu);
+    qemu_spin_lock(&cpu->neg.tlb.c.lock);
+    /*
+     * The jump cache does not consult the TLB on a hit: if code ever ran from one of these
+     * domains in a context (recorded at fill time, kept after the entry is evicted), that
+     * context's jump cache goes too, so the next fetch re-walks and faults like the CPU.
+     */
+    code = asid_cur_code_domains & domains;
+    asid_cur_code_domains &= ~domains;
+    if (asid_cur_domains & domains) {
+        for (int i = 0; i < NB_MMU_MODES; i++) {
+            if (cpu->neg.tlb.c.dirty >> i & 1) {
+                tlb_drop_domains_locked(&cpu->neg.tlb.d[i], cpu_tlb_fast(cpu, i), domains);
+            }
+        }
+        asid_cur_domains &= ~domains;
+    }
+    for (int k = 0; cpu == asid_cpu && k < ASID_CTX_MAX; k++) {
+        AsidCtx *c = &asid_ctx[k];
+        bool pc = c->valid && (c->code_domains & domains);
+        if (!c->valid || !((c->domains | c->code_domains) & domains)) {
+            continue;
+        }
+        for (int i = 0; i < NB_MMU_MODES; i++) {
+            if (c->dirty >> i & 1) {
+                tlb_drop_domains_locked(&c->d[i], &c->f[mmuidx_to_fast_index(i)], domains);
+            }
+        }
+        c->domains &= ~domains;
+        c->code_domains &= ~domains;
+        for (int i = 0; pc && c->jc && i < TB_JMP_CACHE_SIZE; i++) {
+            qatomic_set(&c->jc->array[i].tb, NULL);
+        }
+    }
+    qemu_spin_unlock(&cpu->neg.tlb.c.lock);
+    if (code) {
+        tcg_flush_jmp_cache(cpu);       /* no running code of a domain without access */
+    }
+}
+
+/*
+ * a translation cache flush: parked jump caches may point at freed blocks. Runs from
+ * tb_flush__exclusive_or_serial (no vCPU running), hence without the TLB lock.
+ */
+void tlb_asid_tb_flushed(void)
+{
+    for (int k = 0; k < ASID_CTX_MAX; k++) {
+        CPUJumpCache *jc = asid_ctx[k].valid ? asid_ctx[k].jc : NULL;
+        for (int i = 0; jc && i < TB_JMP_CACHE_SIZE; i++) {
+            qatomic_set(&jc->array[i].tb, NULL);
+        }
+    }
+}
+
+void tlb_asid_switch(CPUState *cpu, uint64_t old_key, uint64_t new_key)
+{
+    if (asid_enabled < 0) {
+        const char *e = getenv("SYBORG_ASID_TLB");
+        asid_enabled = !(e && !strcmp(e, "0"));
+    }
+    assert_cpu_is_self(cpu);
+    if (!asid_enabled || (asid_cpu && asid_cpu != cpu) || !cpu->tb_jmp_cache) {
+        tlb_flush(cpu);
+        return;
+    }
+    asid_cpu = cpu;
+    if (old_key == new_key) {
+        return;
+    }
+    asid_stat[0]++;
+    qemu_spin_lock(&cpu->neg.tlb.c.lock);
+    AsidCtx *n = NULL, *o = NULL;
+    for (int k = 0; k < ASID_CTX_MAX; k++) {
+        AsidCtx *c = &asid_ctx[k];
+        if (c->valid && c->key == new_key) {
+            n = c;
+        } else if (c->valid && c->key == old_key) {
+            asid_ctx_free_locked(c);     /* stale copy of the current one: cannot happen */
+        }
+    }
+    for (int k = 0; k < ASID_CTX_MAX; k++) {    /* a free slot, else the least recently used */
+        AsidCtx *c = &asid_ctx[k];
+        if (c == n) {
+            continue;
+        }
+        if (!c->valid) {
+            o = c;
+            break;
+        }
+        if (!o || c->lru < o->lru) {
+            o = c;
+        }
+    }
+    if (o->valid) {
+        asid_ctx_free_locked(o);
+        asid_stat[5]++;
+    }
+    /* park the current address space */
+    memcpy(o->d, cpu->neg.tlb.d, sizeof(o->d));
+    memcpy(o->f, cpu->neg.tlb.f, sizeof(o->f));
+    o->dirty = cpu->neg.tlb.c.dirty;
+    o->domains = asid_cur_domains;
+    o->code_domains = asid_cur_code_domains;
+    o->jc = cpu->tb_jmp_cache;
+    o->key = old_key;
+    o->lru = ++asid_tick;
+    o->valid = true;
+    if (n) {                                     /* bring the new one back */
+        memcpy(cpu->neg.tlb.d, n->d, sizeof(n->d));
+        memcpy(cpu->neg.tlb.f, n->f, sizeof(n->f));
+        cpu->neg.tlb.c.dirty = n->dirty;
+        asid_cur_domains = n->domains;
+        asid_cur_code_domains = n->code_domains;
+        qatomic_set(&cpu->tb_jmp_cache, n->jc);
+        n->jc = NULL;
+        for (int i = 0; i < NB_MMU_MODES; i++) {   /* the tables are the CPU's now */
+            n->f[i].table = NULL;
+            n->d[i].fulltlb = NULL;
+        }
+        n->valid = false;
+        asid_stat[1]++;
+    } else {                                     /* never seen (or dropped): empty tables */
+        int64_t now = get_clock_realtime();
+        for (int i = 0; i < NB_MMU_MODES; i++) {
+            tlb_mmu_init(&cpu->neg.tlb.d[i], cpu_tlb_fast(cpu, i), now);
+        }
+        cpu->neg.tlb.c.dirty = 0;
+        asid_cur_domains = 0;
+        asid_cur_code_domains = 0;
+        qatomic_set(&cpu->tb_jmp_cache, g_new0(CPUJumpCache, 1));
+        asid_stat[2]++;
+    }
+    qemu_spin_unlock(&cpu->neg.tlb.c.lock);
+    asid_ctx_stats();
+}
