+// N95 hybrid (kernel ABI 9.2): drivers loaded from C:/E: are third-party ones built for the N95's
+// kernel; ours are all in ROM (tools/kabi92.py compares the two kernels' driver-facing vtables)
+static TBool Is92Driver(DCodeSeg* aSeg)
+	{
+	const TRomHeader& rh = Epoc::RomHeader();
+	return aSeg && (aSeg->iRunAddress < rh.iRomBase || aSeg->iRunAddress >= rh.iRomBase + rh.iRomSize);
+	}
