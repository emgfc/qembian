+	{
+	const TRomHeader& rh = Epoc::RomHeader();
+	if (pS->iRunAddress < rh.iRomBase || pS->iRunAddress >= rh.iRomBase + rh.iRomSize)
+		{
+		Kern::Printf("N95COMPAT: %S not loaded: RAM-loaded kernel drivers use the 9.2 kernel ABI (KErrNotSupported)",
+					 pS->iFileName);
+		return KErrNotSupported;
+		}
+	}
 
