+// 9.2 RTimer::At()/AtUTC(): Exec::TimerAt(handle, TRequestStatus&, const TTime&) with the time
+// (microseconds since 0 AD, UTC) passed by reference; ours takes the two 32-bit halves by value.
+// Without this every absolute timer fired at once (CentralRepository's cache timer spun at 100%).
+TInt Exec92Shim_TimerAt92(DTimer* aTimer, TRequestStatus& aStatus, const TInt64* aTime)
+	{
+	TInt64 t;
+	kumemget32(&t, aTime, sizeof(t));
+	ExecHandler::TimerAt(aTimer, aStatus, I64LOW(t), I64HIGH(t));
+	return KErrNone;
+	}
+
