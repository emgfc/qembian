+void RelocsProcessor::BuildDsoSymbolMap()
+{
+    if(!iOpts || iOpts->iLibpath.empty())
+        return;
+
+    string paths = iOpts->iLibpath;
+    size_t end = 0;
+    while(end != std::string::npos)
+    {
+        end = paths.find_first_of(";");
+        string dir = paths.substr(0, end);
+        if(end != std::string::npos)
+            paths = paths.substr(end + 1);
+
+        DIR* d = opendir(dir.c_str());
+        if(!d) continue;
+
+        struct dirent* entry;
+        while((entry = readdir(d)) != nullptr)
+        {
+            string fname = entry->d_name;
+            if(fname.size() < 4) continue;
+            string ext = fname.substr(fname.size() - 4);
+            if(ext != ".dso") continue;
+
+            string fullpath = dir;
+            if(!fullpath.empty() && fullpath.back() != '/' && fullpath.back() != '\\')
+                fullpath += "/";
+            fullpath += fname;
+
+            try {
+                ElfParser dsoParser(fullpath);
+                dsoParser.GetElfFileLayout();
+                const char* soname = dsoParser.SOName();
+                if(!soname) continue;
+                string soStr(soname);
+                // linkAs = soname for DSO files
+                string linkAs = soStr;
+
+                // Iterate all symbols
+                uint32_t nSyms = dsoParser.DynSymCount();
+                if(nSyms == 0) continue;
+                for(uint32_t si = 1; si < nSyms; si++)
+                {
+                    Elf32_Sym* sym = dsoParser.GetSymbolTableEntity(si);
+                    if(!sym || sym->st_shndx == SHN_UNDEF) continue;
+                    const char* symName = dsoParser.GetSymbolNameFromStringTable(si);
+                    if(!symName || !symName[0]) continue;
+                    // Only add if not already mapped (first DSO wins)
+                    string symStr(symName);
+                    if(iDsoSymbolMap.find(symStr) == iDsoSymbolMap.end())
+                        iDsoSymbolMap[symStr] = {linkAs, soStr};
+                }
+            } catch(...) {
+                continue;
+            }
+        }
+        closedir(d);
+    }
+}
