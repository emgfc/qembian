+    if(iVersionTbl)
+    {
+        uint32_t i = iVersionTbl[index];
+        linkAs = iVerInfo[i].iLinkAs;
+        SOname = iVerInfo[i].iSOName;
+    }
+    else
+    {
+        // No version table — look up symbol in DSO map
+        const char* symName = iElf->GetSymbolNameFromStringTable(index);
+        if(symName)
+        {
+            auto it = iDsoSymbolMap.find(string(symName));
+            if(it != iDsoSymbolMap.end())
+            {
+                linkAs = it->second.first;
+                SOname = it->second.second;
+            }
+            else
+            {
+                // Symbol not found in any DSO — skip
+                iImportsCount--; // undo the increment
+                return;
+            }
+        }
+        else
+        {
+            iImportsCount--;
+            return;
+        }
+    }
+
     iImports[linkAs].insert(iImports[linkAs].end(),
            ElfImportRelocation {
                 iSymNdx : index,
