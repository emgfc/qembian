 void DLcdPowerHandler::DisplayOff()
 {
+#ifdef SYBORG_FB_N95
+  // N95 hybrid hack H-lcd-alwayson (docs/hacks.md): log and keep the panel on, so that a
+  // display-off request (screen saver, light/power policy) never freezes the picture.
+  Kern::Printf("N95LCD: display off requested (ignored)");
+  iDisplayOn = EFalse;
+  return;
+#endif
   PowerDownLcd();
   iDisplayOn = EFalse;
 }
 
