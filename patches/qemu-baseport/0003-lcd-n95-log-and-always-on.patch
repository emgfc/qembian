+#ifdef SYBORG_FB_N95
+// N95 hybrid diagnostic (docs/hacks.md H-lcd-alwayson): every 60 s hash the frame buffer and log it,
+// to tell "nothing draws into the frame buffer" apart from "QEMU does not show it".
+static TUint32* FbProbeAddr;
+static TInt FbProbeWords;
+static void FbProbeDfcFn(TAny*);
+static void FbProbeTimerFn(TAny*);
+static TDfc* FbProbeDfc;
+static NTimer* FbProbeTimer;
+static void FbProbeTimerFn(TAny*) { FbProbeDfc->Add(); }
+static void FbProbeDfcFn(TAny*)
+{
+  TUint32* f = FbProbeAddr;
+  TUint32 sum = 0, first = f[240], diff = 0;
+  for (TInt i = 240; i < FbProbeWords; i += 3)
+	{ sum = sum * 31 + f[i]; if (f[i] != first) ++diff; }
+  Kern::Printf("SYBLCD: fb probe hash %08x diff %d px(0,1)=%08x px(120,160)=%08x px(10,300)=%08x",
+	sum, diff, first, f[160 * 240 + 120], f[300 * 240 + 10]);
+  FbProbeTimer->OneShot(NKern::TimerTicks(60000));
+}
+static void FbProbeStart(TUint32* aAddr, TInt aWords)
+{
+  FbProbeAddr = aAddr; FbProbeWords = aWords;
+  FbProbeDfc = new TDfc(FbProbeDfcFn, NULL, Kern::DfcQue0(), 7);
+  FbProbeTimer = new NTimer(FbProbeTimerFn, NULL);
+  if (FbProbeDfc && FbProbeTimer)
+	FbProbeTimer->OneShot(NKern::TimerTicks(60000));
+}
+#endif
