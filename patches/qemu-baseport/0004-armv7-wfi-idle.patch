--- a/baseport/syborg/specific/interrupts.cia
+++ b/baseport/syborg/specific/interrupts.cia
@@ -39,7 +39,8 @@
 {
 	// Enter an idle state and wait for interrupts
 	asm("mov r0, #0");
-	asm("mcr p15, 0, r0, c7, c0, 4");
+	asm("mcr p15, 0, r0, c7, c0, 4");	// ARMv6 CP15 wait-for-interrupt (a NOP on ARMv7)
+	asm(".word 0xe320f003");		// ARMv7 WFI (syborg-pg: modern QEMU halts only on this)
 	asm("bx lr");
 }
 
