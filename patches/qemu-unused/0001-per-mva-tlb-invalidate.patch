+/* syborg-pg: invalidate the soft-TLB entries an ARMv6/v7 "TLB invalidate by MVA"
+   can cover. The soft TLB holds every mapping as TARGET_PAGE_SIZE (1k) pages, so a
+   section (1M/16M), 64k or 4k page is several entries: look at the current page
+   tables and flush the whole TLB for sections or an empty L1 slot (the section may
+   just have been unmapped), all 1k pieces of a 64k page, else of the 4k page.  */
+static void tlb_flush_mva(CPUState *env, uint32_t mva)
+{
+    uint32_t desc, l2;
+    int i;
+
+    if (!(env->cp15.c1_sys & (1 << 23))) {   /* not the v6 table format */
+        tlb_flush(env, 1);
+        return;
+    }
+    desc = ldl_phys(get_level1_table_address(env, mva));
+    if ((desc & 3) != 1) {                    /* fault, section or supersection */
+        tlb_flush(env, 1);
+        return;
+    }
+    l2 = ldl_phys((desc & 0xfffffc00) | ((mva >> 10) & 0x3fc));
+    if ((l2 & 3) == 1) {                      /* 64k page */
+        mva &= 0xffff0000;
+        for (i = 0; i < 0x10000; i += TARGET_PAGE_SIZE)
+            tlb_flush_page(env, mva + i);
+        return;
+    }
+    mva &= 0xfffff000;                        /* 4k page */
+    for (i = 0; i < 0x1000; i += TARGET_PAGE_SIZE)
+        tlb_flush_page(env, mva + i);
+}
